# ---------------------------------------------------------------------------
# Mall 3D Explorer — environment variables
# Copy to `.env.local` and fill in values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Assets (Cloudflare R2 / CDN later). When empty, the app serves from /assets/* (public/).
NEXT_PUBLIC_ASSET_BASE_URL=

# API origin for shop business data. Empty => demo data (built-in mock repository).
NEXT_PUBLIC_API_BASE_URL=

# Force a data source. Mock | Api. Empty => auto (Api when URL set, else Mock).
NEXT_PUBLIC_DATA_SOURCE=
NEXT_PUBLIC_MODEL_SOURCE=demo

# Optional: backend / object-store credentials (server-side only, never NEXT_PUBLIC_)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
DATABASE_URL=